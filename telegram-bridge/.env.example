# Never commit the real values below. Create TG_SESSION_STRING with `python login.py`.
TG_API_ID=123456
TG_API_HASH=replace_with_your_telegram_api_hash
TG_SESSION_STRING=replace_with_the_generated_session_string

# Comma-separated channel usernames or IDs selected by you.
TG_CHANNELS=channel_one,channel_two

RADAR_API_URL=https://your-worker.workers.dev
RADAR_INGEST_TOKEN=replace_with_the_worker_ingest_secret

# Persistent Docker volume is used by default; these are optional.
BACKFILL_MESSAGES=20
MAX_MESSAGE_AGE_MINUTES=180
HEARTBEAT_SECONDS=30
AUTO_JOIN_CHANNELS=false
